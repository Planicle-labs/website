---
import mark from "../../assets/snug/snug-mark.png?url";
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__brand">
      <span class="logo__tile logo__tile--lg"><img src={mark} alt="" width="56" height="56" loading="lazy" /></span>
      <div>
        <p class="foot__word">snug</p>
        <p class="mono-s">Your size, translated.</p>
      </div>
    </div>
    <p class="foot__by">by <a href="/">Planicle Labs</a></p>
  </div>
</footer>
