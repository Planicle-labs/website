---
import LiveClock from "./LiveClock.astro";
import Logo from "./Logo.astro";

const navLinks = [
  { href: "#services", label: "SERVICES" },
  { href: "#process", label: "PROCESS" },
];
const title = (label: string) => label.charAt(0) + label.slice(1).toLowerCase();
---

<header class="nav-header fixed top-4 inset-x-0 flex justify-center z-50" data-nav>
  <div class="nav-bar w-[calc(100%-clamp(1rem,3.5vw,2.5rem))] rounded-full px-[clamp(0.75rem,2.5vw,1.25rem)] flex items-center justify-between border border-n-100/10 bg-n-700 shadow-[0_8px_32px_rgba(0,0,0,0.24)] backdrop-blur-xl backdrop-saturate-150 overflow-hidden">
    <nav class="hidden md:flex items-center gap-fluid-gap-md pl-2 flex-1" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} data-nav-link data-tap="0.95" aria-label={`Jump to ${title(link.label)} section`} class="font-mono text-[11px] font-bold tracking-[0.15em] text-n-500 hover:text-brand-orange transition-colors duration-300 select-none">{link.label}</a>
      ))}
    </nav>

    <a href="#" data-nav-link data-tap="0.95" class="flex items-center gap-2 select-none group md:absolute md:left-1/2 md:-translate-x-1/2">
      <div class="relative w-9 h-9 shrink-0">
        <Logo class="absolute inset-0 h-full w-full" />
      </div>
      <span class="nav-brand overflow-hidden whitespace-nowrap font-antonio text-[19px] uppercase tracking-[0.08em] font-bold text-n-100 leading-none">PLANICLE</span>
    </a>

    <div class="flex items-center gap-fluid-gap-md flex-1 justify-end">
      <div class="nav-clock hidden md:inline-flex">
        <LiveClock class="text-[11px] font-mono text-n-500 select-none" />
      </div>

      <button type="button" data-booking data-tap="0.97" data-hover="1.03" class="hidden md:inline-flex group items-center bg-n-100 hover:bg-n-200 text-n-700 rounded-full pl-4 pr-2 py-1.5 transition-colors duration-300 cursor-pointer border-none outline-none">
        <span class="font-mono text-[10px] font-bold tracking-widest mr-3 select-none">LET&apos;S BUILD</span>
        <span class="w-5 h-5 bg-n-700 text-n-100 rounded-full flex items-center justify-center text-[9px] font-bold transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:rotate-45">»</span>
      </button>

      <button type="button" data-menu-toggle data-tap="0.95" class="md:hidden bg-n-100 text-n-700 hover:bg-n-200 rounded-full w-11 h-11 flex items-center justify-center cursor-pointer transition-colors" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobile-nav-menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu" aria-hidden="true" data-icon-open><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"></path></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x hidden" aria-hidden="true" data-icon-close><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>
  </div>
</header>

<div class="fixed inset-0 z-40 bg-n-700 flex flex-col p-6 sm:p-8 md:hidden" id="mobile-nav-menu" hidden>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,255,255,0.03),transparent_50%)] pointer-events-none"></div>

  <nav class="flex-1 flex flex-col justify-center gap-8 mt-16 relative z-10" aria-label="Mobile primary">
    {navLinks.map((link) => (
      <div class="overflow-hidden py-2">
        <a href={link.href} data-nav-link data-menu-link class="block text-[16vw] font-serif italic tracking-tight text-n-100 hover:text-brand-orange transition-colors duration-400 leading-none">{title(link.label)}</a>
      </div>
    ))}
  </nav>

  <div class="relative z-10 flex flex-col gap-6 border-t border-n-100/10 pt-6 pb-2" data-menu-footer>
    <button type="button" data-booking data-menu-close data-tap="0.97" class="group inline-flex items-center justify-center self-center bg-brand-orange hover:bg-brand-orange/90 text-white rounded-full pl-6 pr-2 py-3 transition-colors duration-300 cursor-pointer border-none outline-none">
      <span class="font-mono text-[11px] font-bold tracking-widest mr-4 select-none">LET&apos;S BUILD</span>
      <span class="w-8 h-8 bg-white text-brand-orange rounded-full flex items-center justify-center text-[11px] font-bold transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:rotate-45">»</span>
    </button>

    <div class="flex items-center justify-center">
      <LiveClock class="text-[12px] font-mono text-n-400" />
    </div>
  </div>
</div>
