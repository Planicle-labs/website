---
import { PHASES, getLayerMotion, getLayerTransform } from "../data/phases";

/**
 * Classes that depend on whether a phase is active are rendered for the initial
 * phase. Only the tokens that differ between the two states are kept, in
 * data-on and data-off; process.ts swaps them when the active phase changes, so
 * elements persist and their CSS transitions run.
 */
const tokens = (s: string) => s.split(/\s+/).filter(Boolean);
const dyn = (active: boolean, build: (active: boolean) => string) => {
  const on = tokens(build(true));
  const off = tokens(build(false));
  const onOnly = on.filter((t) => !off.includes(t));
  const offOnly = off.filter((t) => !on.includes(t));
  const cls = (active ? on : off).join(" ");
  return onOnly.length || offOnly.length ? { class: cls, "data-on": onOnly.join(" "), "data-off": offOnly.join(" ") } : { class: cls };
};
const css = (style: Record<string, string | number>) =>
  Object.entries(style)
    .map(([k, v]) => `${k.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}:${v}`)
    .join(";");
---

    <section data-process
      id="process"
      class="relative w-full select-none"
      style={css({ height: '350vh' })}
    >
      {/* STICKY CONTAINER LOCKS IN VIEWPORT DURING SCROLL RANGE */}
      <div
        class="sticky top-0 w-full flex flex-col bg-[#F7F7F7]"
        style={css({ height: '100dvh', overflow: 'clip' })}
      >

        {/* Subtle hairline grid — matching Inspiration 2.webp: barely perceptible cross-hatch */}
        <div
          class="absolute inset-0 pointer-events-none"
          style={css({
            backgroundImage: `
              linear-gradient(to right, rgba(0,0,0,0.03) 1px, transparent 1px),
              linear-gradient(to bottom, rgba(0,0,0,0.03) 1px, transparent 1px)
            `,
            backgroundSize: '80px 80px'
          })}
        />

        {/* Top border separator */}
        <div class="absolute top-0 left-0 right-0 h-px bg-[#E4E3DD]" />

        <div class="w-full max-w-7xl mx-auto px-fluid-x flex flex-col gap-y-fluid-gap-md justify-start lg:justify-between h-full pt-28 pb-3 sm:pt-16 sm:pb-6 lg:pt-16 lg:pb-6 z-10 relative">

          {/* ═══════════════════════════════════════════════════════ */}
          {/* HEADER BLOCK — Matches Inspiration 2.webp exactly     */}
          {/* Centered: TRUST THE PROCESS pill → Think big, make it */}
          {/* real headline → body copy underneath                   */}
          {/* ═══════════════════════════════════════════════════════ */}
          <div class="flex flex-col items-center text-center max-w-3xl mx-auto shrink-0">
            {/* Main headline — serif, two lines, sentence case */}
            <h2 class="font-serif text-[clamp(1.75rem,5vw,3.25rem)] font-normal leading-[1.05] tracking-tight text-[#0C0C0E]">
              Think big,
              <br />
              <span class="italic font-light text-[#EF4A2A]">make it real</span>
            </h2>

            {/* Body copy — exact match from Inspiration 2.webp */}
            <p class="font-sans text-[13px] sm:text-[16px] text-[#5C5B56] leading-[1.65] mt-3 sm:mt-5 max-w-xl">
              Got a vision? Let&apos;s bring it to life together. We don&apos;t just meet goals, we deliver exactly what you need to stand out and lead.
            </p>
          </div>

          {/* ═══════════════════════════════════════════════════════ */}
          {/* DESKTOP THREE-COLUMN INTERACTIVE INTERFACE (lg:flex)   */}
          {/* ═══════════════════════════════════════════════════════ */}
          <div class="hidden lg:grid lg:grid-cols-[130px_1fr_320px] gap-20 items-center justify-center w-full mt-10 mb-6 pb-0 my-auto overflow-visible flex-1">

            {/* ─── COLUMN 1: PHASE LABELS (Desktop) ─── */}
            <div
              class="hidden lg:flex flex-col gap-2.5 justify-center items-start h-full"
              role="tablist"
              aria-label="Project phases"
            >
              {PHASES.map((phase, idx) => {
                const isActive = idx === 0;
                return (
                  <button
                    type="button"
                    role="tab"
                    aria-selected={isActive ? "true" : "false"}
                    aria-controls="process-phase-content"
                    aria-label={`Phase ${idx + 1}: ${phase.label}`}
                    data-tab={idx}
                    {...dyn(isActive, (isActive: boolean) => `relative inline-flex items-center justify-center w-27.5 py-2 rounded-full border transition-all duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] font-mono text-[10px] font-bold tracking-[0.16em] cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-[#EF4A2A] focus-visible:ring-offset-2 ${isActive
                      ? 'bg-[#161618] border-[#161618] text-white shadow-sm translate-x-1'
                      : 'bg-transparent border-[#E4E3DD] text-[#6B6A65] hover:border-[#161618] hover:text-[#161618]'
                      }`)}
                  >
                    {/* Connector line from active label to card stack */}
                    <div {...dyn(isActive, (isActive: boolean) => `absolute left-full top-1/2 -translate-y-1/2 w-15 lg:w-20 h-px bg-[#E4E3DD]${isActive ? '' : ' hidden'}`)}>
                        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-[#EF4A2A]" />
                      </div>
                    {phase.label}
                  </button>
                );
              })}
            </div>

            {/* ─── COLUMN 2: 3D ISOMETRIC CARD STACK (Center) ─── */}
            <div class="flex items-center justify-center py-1 lg:py-4 relative w-full h-45 sm:h-60 lg:h-full max-w-70 sm:max-w-90 lg:max-w-105 lg:-translate-x-8 lg:-translate-y-4 mx-auto overflow-visible shrink-0 max-sm:max-w-[85vw]">
              <div
                class="w-full aspect-4/3 relative overflow-visible"
              >
                {/* Isometric Slant Projection — perspective() in transform chain ensures cross-browser parity */}
                <div
                  class='w-full h-full relative transform-[perspective(1200px)_rotateX(55deg)_rotateZ(-35deg)_skewX(-4deg)_scale(0.68)] sm:transform-[perspective(1200px)_rotateX(55deg)_rotateZ(-35deg)_skewX(-4deg)_scale(0.8)] lg:transform-[perspective(1200px)_rotateX(55deg)_rotateZ(-35deg)_skewX(-4deg)_scale(0.88)]'
                  style={css({ transformStyle: 'preserve-3d' })}
                >
                  {PHASES.map((_, idx) => {
                    const isActive = idx === 0;
                    const initialMotion = getLayerMotion(idx, 0);
                    return (
                      <div data-layer={idx}
                        style={css({
                          zIndex: isActive ? 10 : 5 - idx,
                          transform: getLayerTransform(initialMotion),
                          opacity: initialMotion.opacity,
                          willChange: 'transform, opacity',
                          transformStyle: 'preserve-3d',
                          backfaceVisibility: 'hidden',
                        })}
                        {...dyn(isActive, (isActive: boolean) => `absolute inset-0 rounded-xl border flex flex-col justify-between ${
                          isActive
                            ? idx === 4
                              ? 'border-[#EF4A2A] bg-[#FFF5F2]'
                              : 'border-[#EF4A2A] bg-white'
                            : idx === 0
                              ? 'border-[#E4E3DD] bg-[#FAF9F5]'
                              : 'border-[#E4E3DD] bg-white'
                        }`)}
                      >
                        <div
                          {...dyn(isActive, (isActive: boolean) => `absolute inset-0 rounded-xl pointer-events-none transition-shadow duration-300 ${
                            isActive
                              ? 'shadow-[0_12px_32px_rgba(239,74,42,0.12)]'
                              : 'shadow-[0_4px_16px_rgba(0,0,0,0.03)]'
                          }`)}
                        />
                        {/* PHASE 01 — PLAN: Thick Baseboard / Hardware Slab */}
                        {idx === 0 && (
                          <div class="flex-1 w-full h-full relative p-4 flex flex-col justify-between select-none">
                            {/* Inner panel bevel border */}
                            <div {...dyn(isActive, (isActive: boolean) => `absolute inset-1.5 rounded-lg border ${isActive ? 'border-[#EF4A2A]/40' : 'border-[#EEEDE9]'} pointer-events-none`)} />

                            {/* Corner mechanical screw holes */}
                            <div class="absolute top-3 left-3 w-3 h-3 rounded-full border border-[#D0CFC9] bg-[#EBEAE4] flex items-center justify-center shadow-[inset_0_1px_2px_rgba(0,0,0,0.1)]">
                              <div class="w-1 h-1 rounded-full bg-[#A09F9A]" />
                            </div>
                            <div class="absolute top-3 right-3 w-3 h-3 rounded-full border border-[#D0CFC9] bg-[#EBEAE4] flex items-center justify-center shadow-[inset_0_1px_2px_rgba(0,0,0,0.1)]">
                              <div class="w-1 h-1 rounded-full bg-[#A09F9A]" />
                            </div>
                            <div class="absolute bottom-3 left-3 w-3 h-3 rounded-full border border-[#D0CFC9] bg-[#EBEAE4] flex items-center justify-center shadow-[inset_0_1px_2px_rgba(0,0,0,0.1)]">
                              <div class="w-1 h-1 rounded-full bg-[#A09F9A]" />
                            </div>
                            <div class="absolute bottom-3 right-3 w-3 h-3 rounded-full border border-[#D0CFC9] bg-[#EBEAE4] flex items-center justify-center shadow-[inset_0_1px_2px_rgba(0,0,0,0.1)]">
                              <div class="w-1 h-1 rounded-full bg-[#A09F9A]" />
                            </div>

                            {/* Header details */}
                            <div class="w-full flex justify-between items-center px-8 pt-1 shrink-0">
                              <span {...dyn(isActive, (isActive: boolean) => `font-mono text-[7px] font-bold tracking-[0.2em] ${isActive ? 'text-[#EF4A2A]/60' : 'text-[#A09F9A]'}`)}>PLANNING UNIT</span>
                              <div class="flex gap-1">
                                <div {...dyn(isActive, (isActive: boolean) => `w-3 h-1 rounded-full ${isActive ? 'bg-[#EF4A2A]/40' : 'bg-[#E4E3DD]'}`)} />
                                <div {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1 rounded-full ${isActive ? 'bg-[#EF4A2A]/20' : 'bg-[#E4E3DD]/50'}`)} />
                              </div>
                            </div>

                            {/* Circuit nodes & horizontal slot */}
                            <div class="flex-1 flex flex-col items-center justify-center px-6 gap-3">
                              <div {...dyn(isActive, (isActive: boolean) => `w-[72%] h-4 rounded-full border ${isActive ? 'border-[#EF4A2A]/30 bg-[#EF4A2A]/5' : 'border-[#E4E3DD] bg-[#F7F7F7]'} flex items-center justify-center shrink-0`)}>
                                <span {...dyn(isActive, (isActive: boolean) => `font-mono text-[8px] tracking-[0.15em] font-medium ${isActive ? 'text-[#EF4A2A]/70' : 'text-[#797872]'}`)}>BASEPLATE SYSTEM</span>
                              </div>

                              <div class="w-full max-w-45 flex justify-between items-center relative mt-1 shrink-0">
                                <div {...dyn(isActive, (isActive: boolean) => `absolute left-0 right-0 h-px ${isActive ? 'bg-[#EF4A2A]/20' : 'bg-[#E4E3DD]'}`)} />
                                <div {...dyn(isActive, (isActive: boolean) => `relative w-4 h-4 rounded-full border bg-white flex items-center justify-center z-10 ${isActive ? 'border-[#EF4A2A]' : 'border-[#E4E3DD]'}`)}>
                                  <div {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]' : 'bg-[#E4E3DD]'}`)} />
                                </div>
                                <div {...dyn(isActive, (isActive: boolean) => `px-2 py-0.5 rounded border text-[7px] font-mono font-bold bg-white z-10 ${isActive ? 'border-[#EF4A2A]/40 text-[#EF4A2A]' : 'border-[#E4E3DD] text-[#797872]'}`)}>
                                  DB_INIT
                                </div>
                                <div {...dyn(isActive, (isActive: boolean) => `relative w-4 h-4 rounded-full border bg-white flex items-center justify-center z-10 ${isActive ? 'border-[#EF4A2A]' : 'border-[#E4E3DD]'}`)}>
                                  <div {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]' : 'bg-[#E4E3DD]'}`)} />
                                </div>
                              </div>
                            </div>

                            {/* Footer */}
                            <div class="border-t border-[#EEEDE9] pt-2 px-2 flex justify-between items-center text-[7px] font-mono text-[#A09F9A] uppercase tracking-widest shrink-0">
                              <span>SECURE BASE HARDWARE</span>
                              <span {...dyn(isActive, (isActive: boolean) => (isActive ? 'text-[#EF4A2A]' : ''))}>PH-01</span>
                            </div>
                          </div>
                        )}

                        {/* PHASE 02 — DESIGN: Blueprints & Grid Guides */}
                        {idx === 1 && (
                          <div class="flex-1 w-full h-full p-4 flex flex-col justify-between select-none">
                            {/* Top browser bar */}
                            <div class="flex items-center justify-between border-b border-[#EEEDE9] pb-2 shrink-0">
                              <div class="flex gap-1 items-center shrink-0">
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full border ${isActive ? 'border-[#EF4A2A] bg-transparent' : 'border-[#E4E3DD]'}`)} />
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full border ${isActive ? 'border-[#EF4A2A]/60 bg-transparent' : 'border-[#E4E3DD]/60'}`)} />
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full border ${isActive ? 'border-[#EF4A2A]/40 bg-transparent' : 'border-[#E4E3DD]/40'}`)} />
                              </div>
                              <div {...dyn(isActive, (isActive: boolean) => `w-20 h-2 rounded-full border ${isActive ? 'border-[#EF4A2A]/20 bg-transparent' : 'border-[#E4E3DD]/30 bg-transparent'}`)} />
                            </div>

                            {/* Wireframe grids */}
                            <div class="flex-1 py-3 flex gap-3 items-center justify-between overflow-hidden">
                              <div {...dyn(isActive, (isActive: boolean) => `w-[30%] h-[85%] border border-dashed rounded-md p-1.5 flex flex-col gap-1.5 shrink-0 ${isActive ? 'border-[#EF4A2A]/30' : 'border-[#E4E3DD]'}`)}>
                                <div {...dyn(isActive, (isActive: boolean) => `h-2 w-full rounded border ${isActive ? 'border-[#EF4A2A]/40' : 'border-[#E4E3DD]'}`)} />
                                <div {...dyn(isActive, (isActive: boolean) => `h-1.5 w-3/4 rounded border border-dashed ${isActive ? 'border-[#EF4A2A]/30' : 'border-[#E4E3DD]/70'}`)} />
                                <div {...dyn(isActive, (isActive: boolean) => `h-1.5 w-1/2 rounded border border-dashed ${isActive ? 'border-[#EF4A2A]/30' : 'border-[#E4E3DD]/70'}`)} />
                              </div>

                              <div {...dyn(isActive, (isActive: boolean) => `flex-1 h-[85%] border border-dashed rounded-md p-2 flex flex-col gap-2 relative justify-center ${isActive ? 'border-[#EF4A2A]/40' : 'border-[#E4E3DD]'}`)}>
                                <div class="flex gap-2 flex-1 items-center">
                                  <div {...dyn(isActive, (isActive: boolean) => `flex-1 h-[80%] rounded border flex flex-col items-center justify-center border-dashed ${isActive ? 'border-[#EF4A2A]/40' : 'border-[#E4E3DD]/70'}`)}>
                                    <div {...dyn(isActive, (isActive: boolean) => `w-2 h-2 rounded-full border ${isActive ? 'border-[#EF4A2A]' : 'border-[#E4E3DD]'}`)} />
                                  </div>
                                  <div {...dyn(isActive, (isActive: boolean) => `flex-1 h-[80%] rounded border flex flex-col items-center justify-center border-dashed ${isActive ? 'border-[#EF4A2A]/40' : 'border-[#E4E3DD]/70'}`)}>
                                    <div {...dyn(isActive, (isActive: boolean) => `w-2 h-2 rounded-full border ${isActive ? 'border-[#EF4A2A]' : 'border-[#E4E3DD]'}`)} />
                                  </div>
                                </div>
                              </div>
                            </div>

                            {/* Footer */}
                            <div class="border-t border-[#EEEDE9] pt-2 flex justify-between items-center text-[7px] font-mono text-[#A09F9A] uppercase tracking-widest shrink-0">
                              <span>BLUEPRINT SYSTEMS</span>
                              <span {...dyn(isActive, (isActive: boolean) => (isActive ? 'text-[#EF4A2A]' : ''))}>PH-02</span>
                            </div>
                          </div>
                        )}

                        {/* PHASE 03 — DEVELOP: Modular Grid Blocks */}
                        {idx === 2 && (
                          <div class="flex-1 w-full h-full p-4 flex flex-col justify-between select-none">
                            <div class="flex items-center justify-between border-b border-[#EEEDE9] pb-2 shrink-0">
                              <div class="flex gap-1 items-center shrink-0">
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]/60' : 'bg-[#E4E3DD]'}`)} />
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]/40' : 'bg-[#E4E3DD]'}`)} />
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]/20' : 'bg-[#E4E3DD]'}`)} />
                              </div>
                              <div class="flex gap-1">
                                <div {...dyn(isActive, (isActive: boolean) => `w-5 h-2 rounded-sm ${isActive ? 'bg-[#EF4A2A]/10 border border-[#EF4A2A]/20' : 'bg-[#EEEDE9] border border-[#E4E3DD]'}`)} />
                                <div class="w-3 h-2 rounded-sm bg-[#EEEDE9]" />
                              </div>
                            </div>

                            <div class="flex-1 py-3 flex gap-3 items-center justify-between overflow-hidden">
                              <div class="flex-1 h-[85%] flex flex-col gap-1.5 justify-center">
                                <div {...dyn(isActive, (isActive: boolean) => `h-4 rounded border flex items-center px-1.5 justify-between ${isActive ? 'border-[#EF4A2A]/30 bg-[#EF4A2A]/5' : 'border-[#E4E3DD] bg-[#F7F7F7]'}`)}>
                                  <div {...dyn(isActive, (isActive: boolean) => `w-2.5 h-2.5 rounded ${isActive ? 'bg-[#EF4A2A]/30' : 'bg-[#E4E3DD]'}`)} />
                                  <div {...dyn(isActive, (isActive: boolean) => `w-[60%] h-1.5 rounded ${isActive ? 'bg-[#EF4A2A]/20' : 'bg-[#E4E3DD]/60'}`)} />
                                </div>
                                <div {...dyn(isActive, (isActive: boolean) => `h-4 rounded border flex items-center px-1.5 justify-between ${isActive ? 'border-[#EF4A2A]/30 bg-[#EF4A2A]/5' : 'border-[#E4E3DD] bg-[#F7F7F7]'}`)}>
                                  <div {...dyn(isActive, (isActive: boolean) => `w-2.5 h-2.5 rounded ${isActive ? 'bg-[#EF4A2A]/30' : 'bg-[#E4E3DD]'}`)} />
                                  <div {...dyn(isActive, (isActive: boolean) => `w-[45%] h-1.5 rounded ${isActive ? 'bg-[#EF4A2A]/20' : 'bg-[#E4E3DD]/60'}`)} />
                                </div>
                              </div>

                              <div {...dyn(isActive, (isActive: boolean) => `w-[52%] h-[85%] rounded-lg border p-2 flex flex-col gap-2 justify-between shrink-0 ${isActive ? 'border-[#EF4A2A]/30 bg-white shadow-sm' : 'border-[#E4E3DD] bg-[#FAF9F6]'}`)}>
                                <div class="flex justify-between items-center">
                                  <div {...dyn(isActive, (isActive: boolean) => `w-8 h-1.5 rounded ${isActive ? 'bg-[#EF4A2A]/20' : 'bg-[#E4E3DD]'}`)} />
                                  <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]' : 'bg-[#E4E3DD]'}`)} />
                                </div>
                                <div {...dyn(isActive, (isActive: boolean) => `flex-1 rounded border p-1 flex gap-1 ${isActive ? 'border-[#EF4A2A]/10 bg-[#EF4A2A]/5' : 'border-[#EEEDE9] bg-[#F2F1ED]'}`)}>
                                  <div {...dyn(isActive, (isActive: boolean) => `flex-1 rounded bg-white border ${isActive ? 'border-[#EF4A2A]/20' : 'border-[#E4E3DD]/40'}`)} />
                                  <div {...dyn(isActive, (isActive: boolean) => `flex-1 rounded bg-white border ${isActive ? 'border-[#EF4A2A]/20' : 'border-[#E4E3DD]/40'}`)} />
                                </div>
                              </div>
                            </div>

                            <div class="border-t border-[#EEEDE9] pt-2 flex justify-between items-center text-[7px] font-mono text-[#A09F9A] uppercase tracking-widest shrink-0">
                              <span>MODULAR SYSTEM</span>
                              <span {...dyn(isActive, (isActive: boolean) => (isActive ? 'text-[#EF4A2A]' : ''))}>PH-03</span>
                            </div>
                          </div>
                        )}

                        {/* PHASE 04 — TEST: Checklists & Verification Dials */}
                        {idx === 3 && (
                          <div class="flex-1 w-full h-full p-4 flex flex-col justify-between select-none">
                            <div class="flex items-center justify-between border-b border-[#EEEDE9] pb-2 shrink-0">
                              <div class="flex gap-1 items-center shrink-0">
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]/70' : 'bg-[#E4E3DD]'}`)} />
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]/50' : 'bg-[#E4E3DD]'}`)} />
                                <span {...dyn(isActive, (isActive: boolean) => `w-1.5 h-1.5 rounded-full ${isActive ? 'bg-[#EF4A2A]/30' : 'bg-[#E4E3DD]'}`)} />
                              </div>
                              <span {...dyn(isActive, (isActive: boolean) => `font-mono text-[7px] tracking-wider px-1.5 py-0.5 border rounded-sm ${isActive ? 'text-[#EF4A2A] border-[#EF4A2A]/30 bg-[#EF4A2A]/5' : 'text-[#797872] border-[#E4E3DD]'}`)}>VERIFY.TEST</span>
                            </div>

                            <div class="flex-1 py-3 flex gap-3 items-center justify-between overflow-hidden">
                              <div {...dyn(isActive, (isActive: boolean) => `w-[36%] h-[85%] rounded-lg border flex flex-col items-center justify-center p-1 relative shrink-0 ${isActive ? 'border-[#EF4A2A]/20 bg-white shadow-sm' : 'border-[#E4E3DD] bg-[#FAF9F6]'}`)}>
                                <svg {...dyn(isActive, (isActive: boolean) => `w-10 h-10 -rotate-90 ${isActive ? 'text-[#EF4A2A]' : 'text-[#A09F9A]'}`)} viewBox="0 0 36 36" aria-hidden="true">
                                  <path
                                    class="text-gray-100"
                                    stroke-width="3.5"
                                    stroke="currentColor"
                                    fill="none"
                                    d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                  />
                                  <path
                                    stroke-width="3.5"
                                    stroke-dasharray="75, 100"
                                    stroke-linecap="round"
                                    stroke="currentColor"
                                    fill="none"
                                    d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                                    {...dyn(isActive, (isActive: boolean) => `${isActive ? '' : 'opacity-40'}`)}
                                  />
                                </svg>
                                <span {...dyn(isActive, (isActive: boolean) => `font-mono text-[7px] font-bold mt-1 ${isActive ? 'text-[#EF4A2A]' : 'text-[#797872]'}`)}>75% AA</span>
